<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	{% set brand = config.sd_brand_name|default('Nextcloud') %}
	<title>{{ meta.title ? brand ~ ' — ' ~ meta.title : brand }}</title>
	{% if meta.description %}<meta name="description" content="{{ meta.description|striptags }}">{% endif %}
	{% set static_base = config.sd_theme_static|default(theme_url) %}
	<link rel="stylesheet" href="{{ static_base }}/css/style.css?v={{ config.sd_asset_ver|default('1') }}" />
	<link rel="icon" href="{{ static_base }}/img/favicon.svg" type="image/svg+xml" />
	<style>
		/* Repository listing — on top of the frontpage stylesheet */
		body { background: var(--bg); }
		.repo-main { max-width: 880px; margin: 0 auto; padding: 96px 20px 60px; }
		.repo-main h1 { font-size: 2rem; margin: 0 0 6px; color: var(--ink); }
		.repo-head { display: flex; gap: 28px; align-items: flex-start; }
		.repo-head-main { flex: 1 1 auto; min-width: 0; }
		.repo-intro { color: var(--muted); max-width: 65ch; }
		.repo-intro a { color: var(--accent); }
		.repo-aside { flex: 0 0 260px; background: var(--bg-alt); border: 1px solid var(--line);
			border-radius: 10px; padding: 14px 16px; font-size: .88rem; color: var(--muted); }
		.repo-aside a { color: var(--accent); }
		@media (max-width: 760px) {
			.repo-head { flex-direction: column; }
			.repo-aside { flex: 1 1 auto; width: 100%; box-sizing: border-box; }
		}
		.repo-section { margin-top: 40px; }
		.repo-section > h2 { font-size: 1.15rem; letter-spacing: .04em; text-transform: uppercase;
			color: var(--muted); border-bottom: 1px solid var(--line); padding-bottom: 8px; }
		.repo-list { list-style: none; margin: 0; padding: 0; }
		.repo-item { padding: 16px 4px; border-bottom: 1px solid var(--line); }
		.repo-item h3 { margin: 0 0 2px; font-size: 1.06rem; }
		.repo-item h3 a { color: var(--accent-d); text-decoration: none; }
		.repo-item h3 a:hover { text-decoration: underline; }
		.repo-byline { font-size: .85rem; color: var(--muted); }
		.repo-meta { margin-top: 6px; display: flex; flex-wrap: wrap; gap: 6px; }
		.repo-chip { font-size: .75rem; background: var(--bg-alt); border: 1px solid var(--line);
			border-radius: 999px; padding: 2px 10px; color: var(--ink); }
		.repo-chip b { font-weight: 600; color: var(--muted); }
		.repo-empty { color: var(--muted); font-style: italic; padding: 14px 4px; }
		.repo-filter { display: flex; flex-wrap: wrap; gap: 8px; align-items: center;
			margin: 26px 0 4px; padding: 12px 0; border-bottom: 1px solid var(--line); }
		.repo-search { flex: 1 1 220px; min-width: 180px; padding: 8px 12px;
			border: 1px solid var(--line); border-radius: 8px; font-size: .95rem;
			background: var(--bg); color: var(--ink); }
		.repo-tagchip { font-size: .8rem; border: 1px solid var(--line); background: var(--bg-alt);
			border-radius: 999px; padding: 4px 12px; cursor: pointer; color: var(--ink); user-select: none; }
		.repo-tagchip.active { background: var(--accent); border-color: var(--accent); color: #fff; }
		.repo-itemtag { font-size: .75rem; background: var(--accent); color: #fff;
			border-radius: 999px; padding: 2px 10px; opacity: .85; }
		.repo-item.hidden, .repo-section.hidden { display: none; }
	</style>
</head>
<body>

<header class="site-head scrolled" id="siteHead">
	<a class="brand" href="/">{{ config.sd_brand_html|default(brand)|raw }}</a>
	<nav class="site-nav">
		<a href="/sites/blog">Blog</a>
		<a href="/sites/documentation">Documentation</a>
		{% if config.sd_logged_in %}
			<a class="nav-cta" href="{{ config.sd_files_url }}">Your files</a>
		{% else %}
			<a class="nav-cta" href="{{ config.sd_login_url }}">Log in</a>
		{% endif %}
	</nav>
</header>

<main class="repo-main">
	<div class="repo-head">
		<div class="repo-head-main">
			<h1>{{ meta.title|default('Public data') }}</h1>
			<div class="repo-intro">{{ content }}</div>
		</div>
		{% if meta.contribute %}
		<aside class="repo-aside">{{ meta.contribute|markdown }}</aside>
		{% endif %}
	</div>

	{% set catalog = config.sd_catalog|default([]) %}
	{% set alltags = [] %}
	{% for e in catalog %}{% for tg in e.tags|default([]) %}
		{% if tg not in alltags %}{% set alltags = alltags|merge([tg]) %}{% endif %}
	{% endfor %}{% endfor %}
	{% if catalog|length > 0 %}
	<div class="repo-filter">
		<input class="repo-search" id="repoSearch" type="search"
			placeholder="Search title, owner, metadata…" aria-label="Search the catalog" />
		{% for tg in alltags|sort %}
		<span class="repo-tagchip" data-tag="{{ tg }}">{{ tg }}</span>
		{% endfor %}
	</div>
	{% endif %}
	{# Bundled Twig is v1: no arrow |filter, no loop.last under loop conditions —
	   pre-group with merge, then render plain loops. #}
	{% set ds = [] %}{% set nb = [] %}{% set fl = [] %}
	{% for e in catalog %}
		{% if e.kind == 'dataset' %}{% set ds = ds|merge([e]) %}
		{% elseif e.kind == 'notebook' %}{% set nb = nb|merge([e]) %}
		{% else %}{% set fl = fl|merge([e]) %}{% endif %}
	{% endfor %}
	{% set sections = [
		{ 'title': 'Datasets',  'items': ds },
		{ 'title': 'Jupyter notebooks', 'items': nb },
		{ 'title': 'Files',     'items': fl },
	] %}
	{% for section in sections %}
		{% if section.items|length > 0 %}
		<section class="repo-section">
			<h2>{{ section.title }}</h2>
			<ul class="repo-list">
				{% for e in section.items %}
				{% set hay = e.title ~ ' ' ~ e.owner_name ~ ' ' ~ e.institution %}
				{% for k, v in e.meta %}{% set hay = hay ~ ' ' ~ k ~ ' ' ~ v %}{% endfor %}
				{% for tg in e.tags|default([]) %}{% set hay = hay ~ ' ' ~ tg %}{% endfor %}
				<li class="repo-item" data-search="{{ hay|lower }}"
					data-tags="{{ e.tags|default([])|join('||') }}">
					<h3><a href="{{ e.url }}">{{ e.title }}</a></h3>
					<div class="repo-byline">
						{{ e.owner_name }}{% if e.institution %} · {{ e.institution }}{% endif %}
						{% if e.stime %} · shared {{ e.stime|date('j M Y') }}{% endif %}
					</div>
					{% if e.meta|length > 0 or e.tags|default([])|length > 0 %}
					<div class="repo-meta">
						{% for tg in e.tags|default([]) %}
						<span class="repo-itemtag">{{ tg }}</span>
						{% endfor %}
						{% for k, v in e.meta %}
						<span class="repo-chip"><b>{{ k }}:</b> {{ v }}</span>
						{% endfor %}
					</div>
					{% endif %}
				</li>
				{% endfor %}
			</ul>
		</section>
		{% endif %}
	{% endfor %}
	{% if catalog|length == 0 %}
		<p class="repo-empty">Nothing has been listed yet.</p>
	{% endif %}
</main>

<footer class="site-foot">
	<div class="foot-inner">
		<span>ScienceData — i2, Technical University of Denmark (DTU)</span>
		<a href="mailto:support@sciencedata.dk">support@sciencedata.dk</a>
	</div>
</footer>

<script>
(function () {
	'use strict'
	var active = null
	var search = document.getElementById('repoSearch')
	function writeHash() {
		var parts = []
		if (active) { parts.push('tag=' + encodeURIComponent(active)) }
		if (search && search.value.trim()) { parts.push('q=' + encodeURIComponent(search.value.trim())) }
		var h = parts.join('&')
		history.replaceState(null, '', h ? '#' + h : location.pathname + location.search)
	}
	function apply() {
		var q = (search && search.value || '').toLowerCase().trim()
		document.querySelectorAll('.repo-item').forEach(function (item) {
			var tags = (item.getAttribute('data-tags') || '').split('||').filter(Boolean)
			var okTag = !active || tags.indexOf(active) !== -1
			var okQ = !q || (item.getAttribute('data-search') || '').indexOf(q) !== -1
			item.classList.toggle('hidden', !(okTag && okQ))
		})
		// hide sections whose entries are all hidden
		document.querySelectorAll('.repo-section').forEach(function (sec) {
			var any = sec.querySelector('.repo-item:not(.hidden)')
			sec.classList.toggle('hidden', !any)
		})
	}
	if (search) { search.addEventListener('input', function () { writeHash(); apply() }) }
	document.querySelectorAll('.repo-tagchip').forEach(function (chip) {
		chip.addEventListener('click', function () {
			var tag = chip.getAttribute('data-tag')
			active = (active === tag) ? null : tag
			document.querySelectorAll('.repo-tagchip').forEach(function (c) {
				c.classList.toggle('active', c.getAttribute('data-tag') === active)
			})
			writeHash()
			apply()
		})
	})
	// Restore filter state from the URL hash (kept across record round-trips).
	try {
		var params = {}
		location.hash.replace(/^#/, '').split('&').forEach(function (kv) {
			var i = kv.indexOf('=')
			if (i > 0) { params[kv.slice(0, i)] = decodeURIComponent(kv.slice(i + 1)) }
		})
		if (params.q && search) { search.value = params.q }
		if (params.tag) {
			active = params.tag
			document.querySelectorAll('.repo-tagchip').forEach(function (c) {
				c.classList.toggle('active', c.getAttribute('data-tag') === active)
			})
		}
		if (params.q || params.tag) { apply() }
	} catch (e) { /* cosmetic */ }
})()
</script>

</body>
</html>
