<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	{% set brand = config.sd_brand_name|default('Nextcloud') %}
	{% set ds = config.sd_dataset|default(null) %}
	{% if ds %}
	<title>{{ ds.display_title|default(ds.title) }} — {{ brand }}</title>
	{% if ds.description %}<meta name="description" content="{{ ds.description|striptags|slice(0, 300) }}">{% endif %}
	<link rel="canonical" href="{{ ds.landing_url }}" />
	<script type="application/ld+json">{{ ds.jsonld|raw }}</script>
	{% else %}
	<title>{{ meta.title ? brand ~ ' — ' ~ meta.title : brand }}</title>
	{% if meta.description %}<meta name="description" content="{{ meta.description|striptags }}">{% endif %}
	{% endif %}
	{% set static_base = config.sd_theme_static|default(theme_url) %}
	<link rel="stylesheet" href="{{ static_base }}/css/style.css?v={{ config.sd_asset_ver|default('1') }}" />
	{% if config.favicon %}<link rel="icon" href="{{ base_url }}/{{ config.favicon }}" />{% elseif meta.favicon %}<link rel="icon" href="{{ base_url }}/{{ meta.favicon }}" />{% else %}<link rel="icon" href="{{ config.sd_favicon_url }}" />{% endif %}
	<style>
		/* Repository listing — on top of the frontpage stylesheet */
		body { background: var(--bg); }
		.repo-main { max-width: 880px; margin: 0 auto; padding: 96px 20px 60px; }
		.repo-main h1 { font-size: 2rem; margin: 0 0 6px; color: var(--ink); }
		.repo-head { display: flex; gap: 28px; align-items: flex-start; }
		.repo-head-main { flex: 1 1 auto; min-width: 0; }
		.repo-intro { color: var(--muted); max-width: 65ch; }
		.repo-intro a { color: var(--accent); }
		.repo-aside { flex: 0 0 260px; background: var(--bg-alt); border: 1px solid var(--line);
			border-radius: 10px; padding: 14px 16px; font-size: .88rem; color: var(--muted); }
		.repo-aside a { color: var(--accent); }
		@media (max-width: 760px) {
			.repo-head { flex-direction: column; }
			.repo-aside { flex: 1 1 auto; width: 100%; box-sizing: border-box; }
		}
		.repo-section { margin-top: 40px; }
		.repo-section > h2 { font-size: 1.15rem; letter-spacing: .04em; text-transform: uppercase;
			color: var(--muted); border-bottom: 1px solid var(--line); padding-bottom: 8px; }
		.repo-list { list-style: none; margin: 0; padding: 0; }
		.repo-item { padding: 16px 4px; border-bottom: 1px solid var(--line); }
		.repo-item h3 { margin: 0 0 2px; font-size: 1.06rem; }
		.repo-item h3 a { color: var(--accent-d); text-decoration: none; }
		.repo-item h3 a:hover { text-decoration: underline; }
		.repo-byline { font-size: .85rem; color: var(--muted); }
		.repo-meta { margin-top: 6px; display: flex; flex-wrap: wrap; gap: 6px; }
		.repo-chip { font-size: .75rem; background: var(--bg-alt); border: 1px solid var(--line);
			border-radius: 999px; padding: 2px 10px; color: var(--ink); }
		.repo-chip b { font-weight: 600; color: var(--muted); }
		.repo-empty { color: var(--muted); font-style: italic; padding: 14px 4px; }
		.repo-filter { display: flex; flex-wrap: wrap; gap: 8px; align-items: center;
			margin: 26px 0 4px; padding: 12px 0; border-bottom: 1px solid var(--line); }
		.repo-search { flex: 1 1 220px; min-width: 180px; padding: 8px 12px;
			border: 1px solid var(--line); border-radius: 8px; font-size: .95rem;
			background: var(--bg); color: var(--ink); }
		.repo-tagchip { font-size: .8rem; border: 1px solid var(--line); background: var(--bg-alt);
			border-radius: 999px; padding: 4px 12px; cursor: pointer; color: var(--ink); user-select: none; }
		.repo-tagchip.active { background: var(--accent); border-color: var(--accent); color: #fff; }
		.repo-itemtag { font-size: .75rem; background: var(--accent); color: #fff;
			border-radius: 999px; padding: 2px 10px; opacity: .85; }
		.repo-item.hidden, .repo-section.hidden { display: none; }
		.repo-abstract { margin: 4px 0 0; font-size: .88rem; color: var(--ink);
			display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
		.repo-itemtag { cursor: pointer; }
		.repo-item.truncated { display: none; }
		.repo-viewtoggle { margin: 22px 0 0; text-align: center; }
		.repo-showall { font-size: .9rem; padding: 8px 18px; border-radius: 999px;
			border: 1px solid var(--line); background: var(--bg-alt); color: var(--ink); cursor: pointer; }
		.repo-showall:hover { border-color: var(--accent); color: var(--accent); }
		.repo-showall.hidden { display: none; }
		body.repo-flatmode .repo-section:not(#repoFlat) { display: none; }
		body.repo-flatmode #repoFlat { display: block; }
		/* Landing page of one record */
		.ds-back { display: inline-block; margin-bottom: 18px; color: var(--accent); text-decoration: none; }
		.ds-back:hover { text-decoration: underline; }
		.ds-kind { display: block; font-size: .78rem; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); margin-bottom: 4px; }
		.ds-byline { color: var(--muted); margin: 0 0 18px; }
		.ds-desc { max-width: 70ch; line-height: 1.6; margin: 0 0 22px; white-space: pre-line; }
		.ds-actions { display: flex; flex-wrap: wrap; gap: 10px; margin: 0 0 28px; }
		.ds-btn { display: inline-block; padding: 9px 18px; border-radius: 8px; border: 1px solid var(--line); color: var(--ink); text-decoration: none; background: #fff; }
		.ds-btn:hover { border-color: var(--accent); color: var(--accent); }
		.ds-btn.primary { background: var(--accent); border-color: var(--accent); color: #fff; }
		.ds-btn.primary:hover { filter: brightness(1.08); color: #fff; }
		.ds-facts { display: grid; grid-template-columns: max-content 1fr; gap: 8px 22px; margin: 0 0 28px; }
		.ds-facts dt { color: var(--muted); }
		.ds-facts dd { margin: 0; min-width: 0; overflow-wrap: anywhere; }
		.ds-facts a { color: var(--accent); }
		.ds-section h2 { font-size: 1.15rem; margin: 28px 0 10px; }
		.ds-files { width: 100%; border-collapse: collapse; font-size: .95rem; }
		.ds-files td { padding: 6px 0; border-bottom: 1px solid var(--line); }
		.ds-files td.size { text-align: right; color: var(--muted); white-space: nowrap; padding-left: 16px; font-variant-numeric: tabular-nums; }
		.ds-files-wrap { overflow-x: auto; }
		.ds-more { color: var(--muted); margin-top: 8px; }
		.ds-cite { display: flex; gap: 10px; align-items: flex-start; background: #fff; border: 1px solid var(--line); border-radius: 8px; padding: 14px 16px; }
		.ds-cite p { margin: 0; flex: 1; overflow-wrap: anywhere; }
		.ds-cite button { flex: 0 0 auto; padding: 6px 12px; border-radius: 6px; border: 1px solid var(--line); background: var(--bg); cursor: pointer; font: inherit; }
		.ds-cite button:hover, .ds-cite button:focus-visible { border-color: var(--accent); color: var(--accent); }
		@media (max-width: 600px) { .ds-facts { grid-template-columns: 1fr; gap: 2px 0; } .ds-facts dd { margin-bottom: 8px; } }
		/* the menu wraps to a second line on phones: make room under the taller header */
		@media (max-width: 600px) { .repo-main { padding-top: 130px; } }
	</style>
</head>
<body>

<header class="site-head scrolled" id="siteHead">
	<a class="brand" href="{{ config.sd_home_url|default('/') }}">{{ config.sd_brand_html|default(brand)|raw }}</a>
	<nav class="site-nav">
		<a href="/sites/blog">Blog</a>
		<a href="/sites/documentation">Documentation</a>
		<a href="/sites/terms">Terms</a>
		{% if config.sd_logged_in %}
			<a class="nav-cta" href="{{ config.sd_files_url }}">Your files</a>
		{% else %}
			<a class="nav-cta" href="{{ config.sd_login_url }}">Log in</a>
		{% endif %}
	</nav>
</header>

<main class="repo-main">
	{% if ds %}
	{% set skip = ['authors', 'creators', 'creator', 'author', 'license', 'licence', 'doi', 'description', 'publication_date', 'date', 'year'] %}
	<a class="ds-back" href="{{ config.sd_catalog_url }}">&larr; All public data</a>
	<span class="ds-kind">{{ ds.kind == 'notebook' ? 'Jupyter notebooks' : (ds.kind == 'dataset' ? 'Dataset' : 'File') }}</span>
	<h1>{{ ds.display_title|default(ds.title) }}</h1>
	<p class="ds-byline">Shared by {{ ds.owner_name }}{% if ds.institution %} ({{ ds.institution }}){% endif %}{% if ds.stime %}, {{ ds.stime|date('j F Y') }}{% endif %}</p>
	{% if ds.description %}<p class="ds-desc">{{ ds.description }}</p>{% endif %}
	<div class="ds-actions">
		<a class="ds-btn primary" href="{{ ds.url }}">Browse files</a>
		{% if ds.download_url %}<a class="ds-btn" href="{{ ds.download_url }}">Download{% if ds.contents|length > 0 %} all{% endif %}{% if ds.size_human %} ({{ ds.size_human }}){% endif %}</a>{% endif %}
	</div>
	<dl class="ds-facts">
		<dt>Creators</dt><dd>{{ ds.creators }}</dd>
		<dt>Published</dt><dd>{{ ds.year|default('—') }}</dd>
		{% if ds.doi %}<dt>DOI</dt><dd><a href="https://doi.org/{{ ds.doi }}">{{ ds.doi }}</a></dd>{% endif %}
		<dt>Licence</dt><dd>{{ ds.license|default('Not stated — ask the owner before reusing') }}</dd>
		{% if ds.size_human %}<dt>Size</dt><dd>{{ ds.size_human }}{% if ds.files > 1 %} in {{ ds.files }} files{% endif %}</dd>{% endif %}
		{% if ds.tags|default([])|length > 0 %}<dt>Tags</dt><dd>{{ ds.tags|join(', ') }}</dd>{% endif %}
		{% for k, v in ds.meta %}{% if k|lower not in skip %}<dt>{{ k }}</dt><dd>{{ v }}</dd>{% endif %}{% endfor %}
		<dt>Address</dt><dd><a href="{{ ds.landing_url }}">{{ ds.landing_url }}</a></dd>
	</dl>
	{% if ds.contents|length > 0 %}
	<section class="ds-section">
		<h2>Contents</h2>
		<div class="ds-files-wrap"><table class="ds-files">
			{% for f in ds.contents %}
			<tr><td>{{ f.dir ? '📁 ' : '' }}{{ f.name }}</td><td class="size">{{ f.size >= 0 ? (f.size >= 1000000000 ? (f.size / 1000000000)|number_format(1) ~ ' GB' : (f.size >= 1000000 ? (f.size / 1000000)|number_format(1) ~ ' MB' : (f.size / 1000)|number_format(0) ~ ' kB')) : '' }}</td></tr>
			{% endfor %}
		</table></div>
		{% if ds.more > 0 %}<p class="ds-more">… and {{ ds.more }} more — <a href="{{ ds.url }}">browse all</a></p>{% endif %}
	</section>
	{% endif %}
	<section class="ds-section">
		<h2>Cite</h2>
		<div class="ds-cite"><p id="dsCitation">{{ ds.citation }}</p><button type="button" id="dsCopy">Copy</button></div>
	</section>
	<script>
	(function () {
		var b = document.getElementById('dsCopy')
		if (!b || !navigator.clipboard) { if (b) b.hidden = true; return }
		b.addEventListener('click', function () {
			navigator.clipboard.writeText(document.getElementById('dsCitation').textContent.trim()).then(function () {
				b.textContent = 'Copied'; setTimeout(function () { b.textContent = 'Copy' }, 1600)
			})
		})
	})()
	</script>
	{% elseif config.sd_dataset_missing|default(false) %}
	<a class="ds-back" href="{{ config.sd_catalog_url }}">&larr; All public data</a>
	<h1>Not found</h1>
	<p class="repo-intro">This record is not in the catalogue — it may have been removed, or the link is wrong.</p>
	{% else %}
	<div class="repo-head">
		<div class="repo-head-main">
			<h1>{{ meta.title|default('Public data') }}</h1>
			<div class="repo-intro">{{ content }}</div>
		</div>
		{% if meta.contribute %}
		<aside class="repo-aside">{{ meta.contribute|markdown }}</aside>
		{% endif %}
	</div>

	{% set catalog = config.sd_catalog|default([]) %}
	{% set alltags = [] %}
	{% for e in catalog %}{% for tg in e.tags|default([]) %}
		{% if tg not in alltags %}{% set alltags = alltags|merge([tg]) %}{% endif %}
	{% endfor %}{% endfor %}
	{% if catalog|length > 0 %}
	<div class="repo-filter">
		<input class="repo-search" id="repoSearch" type="search"
			placeholder="Search title, owner, metadata…" aria-label="Search the catalog" />
		{% for tg in alltags|sort %}
		<span class="repo-tagchip" data-tag="{{ tg }}">{{ tg }}</span>
		{% endfor %}
	</div>
	{% endif %}
	{# Bundled Twig is v1: no arrow |filter, no loop.last under loop conditions —
	   pre-group with merge, then render plain loops. #}
	{% set ds = [] %}{% set nb = [] %}{% set fl = [] %}
	{% for e in catalog %}
		{% if e.kind == 'dataset' %}{% set ds = ds|merge([e]) %}
		{% elseif e.kind == 'notebook' %}{% set nb = nb|merge([e]) %}
		{% else %}{% set fl = fl|merge([e]) %}{% endif %}
	{% endfor %}
	{% set sections = [
		{ 'title': 'Datasets',  'items': ds },
		{ 'title': 'Jupyter notebooks', 'items': nb },
		{ 'title': 'Other files', 'items': fl },
	] %}
	{% for section in sections %}
		{% if section.items|length > 0 %}
		<section class="repo-section">
			<h2>{{ section.title }}</h2>
			<ul class="repo-list">
				{% for e in section.items %}
				{% set hay = e.title ~ ' ' ~ e.owner_name ~ ' ' ~ e.institution %}
				{% for k, v in e.meta %}{% set hay = hay ~ ' ' ~ k ~ ' ' ~ v %}{% endfor %}
				{% for tg in e.tags|default([]) %}{% set hay = hay ~ ' ' ~ tg %}{% endfor %}
				<li class="repo-item" data-search="{{ hay|lower }}" data-stime="{{ e.stime|default(0) }}"
					data-tags="{{ e.tags|default([])|join('||') }}">
					<h3><a href="{{ e.token is defined and e.token ? config.sd_catalog_url ~ '?dataset=' ~ e.token|url_encode : e.url }}">{{ e.display_title|default(e.title) }}</a></h3>
					<div class="repo-byline">
						Shared by {{ e.owner_name }}{% if e.institution %} ({{ e.institution }}){% endif %}{% if e.stime %}, {{ e.stime|date('j M Y') }}{% endif %}
					</div>
					{% if e.summary|default('') %}
					<p class="repo-abstract">{{ e.summary }}</p>
					{% endif %}
					{% if e.meta|length > 0 or e.tags|default([])|length > 0 %}
					<div class="repo-meta">
						{% for tg in e.tags|default([]) %}
						<span class="repo-itemtag" data-tag="{{ tg }}" role="button" tabindex="0">{{ tg }}</span>
						{% endfor %}
						{% for k, v in e.meta %}
						<span class="repo-chip"><b>{{ k }}:</b> {{ v }}</span>
						{% endfor %}
					</div>
					{% endif %}
				</li>
				{% endfor %}
			</ul>
		</section>
		{% endif %}
	{% endfor %}
	{% if catalog|length > 10 %}
	<div class="repo-viewtoggle">
		<button type="button" id="repoShowAll" class="repo-showall">{{ 'Show all ' ~ (catalog|length) ~ ' records' }}</button>
		<button type="button" id="repoShowGroups" class="repo-showall hidden">Show grouped view</button>
	</div>
	{% endif %}
	<section class="repo-section hidden" id="repoFlat">
		<h2>All records</h2>
		<ul class="repo-list" id="repoFlatList"></ul>
		<div class="repo-viewtoggle"><button type="button" id="repoNextPage" class="repo-showall hidden">Next 30</button></div>
	</section>
	{% if catalog|length == 0 %}
		<p class="repo-empty">Nothing has been listed yet.</p>
	{% endif %}
	{% endif %}
</main>

<footer class="site-foot">
	<div class="foot-inner">
		{# operator line + support address from config (files_picocms.footer_html), as on the frontpage #}
		{% if config.sd_footer_html|default('') %}{{ config.sd_footer_html|raw }}{% else %}<span>{{ config.sd_brand_name|default('') }}</span>{% endif %}
	</div>
</footer>

<script>
(function () {
	'use strict'
	var active = null
	var search = document.getElementById('repoSearch')
	function writeHash() {
		var parts = []
		if (active) { parts.push('tag=' + encodeURIComponent(active)) }
		if (search && search.value.trim()) { parts.push('q=' + encodeURIComponent(search.value.trim())) }
		var h = parts.join('&')
		history.replaceState(null, '', h ? '#' + h : location.pathname + location.search)
	}
	function apply() {
		var q = (search && search.value || '').toLowerCase().trim()
		var filtering = !!(active || q)
		document.querySelectorAll('.repo-item').forEach(function (item) {
			var tags = (item.getAttribute('data-tags') || '').split('||').filter(Boolean)
			var okTag = !active || tags.indexOf(active) !== -1
			var okQ = !q || (item.getAttribute('data-search') || '').indexOf(q) !== -1
			item.classList.toggle('hidden', !(okTag && okQ))
			// while filtering, truncation gets out of the way (matches must show)
			if (filtering) { item.classList.remove('truncated') }
		})
		if (!filtering) {
			if (document.body.classList.contains('repo-flatmode')) { pageFlat() } else { truncateGroups() }
		}
		// hide sections whose entries are all hidden
		document.querySelectorAll('.repo-section').forEach(function (sec) {
			var any = sec.querySelector('.repo-item:not(.hidden)')
			sec.classList.toggle('hidden', !any)
		})
	}
	if (search) { search.addEventListener('input', function () { writeHash(); apply() }) }
	document.querySelectorAll('.repo-tagchip').forEach(function (chip) {
		chip.addEventListener('click', function () {
			var tag = chip.getAttribute('data-tag')
			active = (active === tag) ? null : tag
			document.querySelectorAll('.repo-tagchip').forEach(function (c) {
				c.classList.toggle('active', c.getAttribute('data-tag') === active)
			})
			writeHash()
			apply()
		})
	})
	// ── Item tag chips act like the top filter chips ──────────────────────────
	function setActive(tag) {
		active = (active === tag) ? null : tag
		document.querySelectorAll('.repo-tagchip').forEach(function (c) {
			c.classList.toggle('active', c.getAttribute('data-tag') === active)
		})
		writeHash()
		apply()
	}
	document.querySelectorAll('.repo-itemtag').forEach(function (chip) {
		var go = function () { setActive(chip.getAttribute('data-tag')) }
		chip.addEventListener('click', go)
		chip.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); go() } })
	})

	// ── Grouped view truncation + flat chronological view ────────────────────
	var TRUNCATE = 10, PAGE = 30
	function truncateGroups() {
		document.querySelectorAll('.repo-section:not(#repoFlat)').forEach(function (sec) {
			var items = sec.querySelectorAll('.repo-item')
			items.forEach(function (it, i) { it.classList.toggle('truncated', i >= TRUNCATE) })
			if (items.length > TRUNCATE && !sec.querySelector('.repo-more-note')) {
				var note = document.createElement('div')
				note.className = 'repo-byline repo-more-note'
				note.style.padding = '10px 4px'
				note.textContent = '… ' + (items.length - TRUNCATE) + ' more — '
				var lnk = document.createElement('a')
				lnk.href = '#'
				lnk.textContent = 'show all records'
				lnk.addEventListener('click', function (e) {
					e.preventDefault()
					var b = document.getElementById('repoShowAll')
					if (b) { b.click() }
				})
				note.appendChild(lnk)
				sec.appendChild(note)
			}
		})
	}
	var flat = document.getElementById('repoFlat')
	var flatList = document.getElementById('repoFlatList')
	var nextBtn = document.getElementById('repoNextPage')
	var showAllBtn = document.getElementById('repoShowAll')
	var showGroupsBtn = document.getElementById('repoShowGroups')
	var flatShown = 0
	function flatItems() {
		return Array.prototype.slice.call(flatList.querySelectorAll('.repo-item'))
	}
	function pageFlat() {
		var items = flatItems()
		items.forEach(function (it, i) { it.classList.toggle('truncated', i >= flatShown) })
		if (nextBtn) { nextBtn.classList.toggle('hidden', flatShown >= items.length) }
	}
	if (showAllBtn && flat && flatList) {
		showAllBtn.addEventListener('click', function () {
			if (flatList.children.length === 0) {
				// move every record into one list, newest first
				var all = Array.prototype.slice.call(document.querySelectorAll('.repo-section:not(#repoFlat) .repo-item'))
				all.sort(function (a, b) { return (+b.getAttribute('data-stime') || 0) - (+a.getAttribute('data-stime') || 0) })
				all.forEach(function (it) { it.classList.remove('truncated'); flatList.appendChild(it) })
			}
			document.body.classList.add('repo-flatmode')
			flat.classList.remove('hidden')
			showAllBtn.classList.add('hidden')
			if (showGroupsBtn) { showGroupsBtn.classList.remove('hidden') }
			flatShown = PAGE
			pageFlat()
		})
	}
	if (showGroupsBtn) {
		showGroupsBtn.addEventListener('click', function () {
			// move items back to their sections in original order
			location.reload()
		})
	}
	if (nextBtn) {
		nextBtn.addEventListener('click', function () { flatShown += PAGE; pageFlat() })
	}
	truncateGroups()

	// Restore filter state from the URL hash (kept across record round-trips).
	try {
		var params = {}
		location.hash.replace(/^#/, '').split('&').forEach(function (kv) {
			var i = kv.indexOf('=')
			if (i > 0) { params[kv.slice(0, i)] = decodeURIComponent(kv.slice(i + 1)) }
		})
		if (params.q && search) { search.value = params.q }
		if (params.tag) {
			active = params.tag
			document.querySelectorAll('.repo-tagchip').forEach(function (c) {
				c.classList.toggle('active', c.getAttribute('data-tag') === active)
			})
		}
		if (params.q || params.tag) { apply() }
	} catch (e) { /* cosmetic */ }
})()
</script>

</body>
</html>
