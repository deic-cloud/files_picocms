<!DOCTYPE html>
<html>
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <meta charset="utf-8" />

    <title>Search results</title>
    {% if meta.description %}
        <meta name="description" content="{{ meta.description|striptags }}">
    {% endif %}{% if meta.robots %}
        <meta name="robots" content="{{ meta.robots }}">
    {% endif %}
    <!-- Bootstrap Core CSS -->
    <link href="{{ theme_url }}/css/bootstrap.min.css" rel="stylesheet">

    <!-- Custom CSS -->
    <link href="{{ theme_url }}/css/blog.css" rel="stylesheet">

    <!-- Custom Fonts -->
    <link href="{{ theme_url }}/css/font-awesome.css" rel="stylesheet" type="text/css">
    <link href="{{ theme_url }}/css/fonts.css" rel="stylesheet" type="text/css">
      {% if config.icon %}<link rel="shortcut icon" href="{{ base_url }}/{{ config.icon }}" />{% elseif config.favicon %}<link rel="shortcut icon" href="{{ base_url }}/{{ config.favicon }}" />{% else %}<link rel="shortcut icon" href="{{ theme_url }}/img/data_icon.png" />{% endif %}
</head>

 <body>
	<a class="sd-backlink" href="{{ config.sd_home_url|default('/') }}" title="{{ config.sd_brand_name|default('Home') }}">{{ config.sd_brand_html|default('Home')|raw }}</a>
	<style>
	.sd-backlink { position: absolute; top: 8px; left: 12px; z-index: 1000;
		font: 700 15px/1.2 -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
		color: inherit; text-decoration: none; opacity: .85; letter-spacing: .2px; }
	.sd-backlink:hover { opacity: 1; text-decoration: none; }
	.sd-backlink .sd-i { position: relative; display: inline-block; line-height: 1; }
	.sd-backlink .sd-i::after { content: ""; position: absolute; left: 50%;
		bottom: 0.76em; transform: translateX(-50%); width: 0.16em; height: 0.16em;
		border-radius: 50%; background: #c00; }
	.sd-backlink { color: #fff; }
	body { padding-top: 26px; }
	</style>


     <!-- Navigation -->

    <header class="intro-header navbar-custom" style="{% if meta.img %}background-image:  url({{ meta.img }})
    {% else %}background: #006286;{% endif %};">
			<div class="span2 navigation">
				<form id="search_form" action="{{ base_url  }}/search">
					<input type="search" id="search_input" name="q" placeholder="Search" />
					<!--<input type="submit" id="search_submit" value="Search" />-->
				</form>
				<script type="text/javascript">
						// Intercept form submit and go to the search results page directly, avoiding a redirect
						document.getElementById('search_form').addEventListener('submit', function (e) {
								var search_terms = document.getElementById('search_input').value;
								location.href = '{{ base_url  }}/search/' + encodeURIComponent(search_terms);
								e.preventDefault();
						});
				</script>
			</div>
			<a class="navbar-brand search-home" href="{{ base_url }}">Home</a>
    </header>

    <div class="container-fluid">
    <div class="row-fluid search-results">
			<div class="span9 main">
				{% for page in pages | reverse %}
					<div class="search_result">
						<h2><a href="{{ page.url }}">{{ page.title }}</a></h2>
						{% if page.description %}<p>{{ page.description }}</p>{% endif %}
					</div>
				{% endfor %} 
			</div>
		</div>
	</div>

</body>
</html>