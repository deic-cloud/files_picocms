<!DOCTYPE html>
{% set nc_root = base_url|split('/remote.php')|first %}
<html lang="en">

<head data-requesttoken="{{ config.requesttoken }}">

    <base href="{{ base_url }}/">
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="{{ meta.description|striptags }}">

    <title>{{ meta.title }} - {{ site_title }}</title>
	<meta content='{{ meta.title }}' property='og:title'/>
	<meta content='article' property='og:type'/>
	<meta content='{{ current_page.url }}' property='og:url'/>
	<meta content='{% if meta.img %}{{ meta.img }}{% else %}{{ theme_url }}/img/iceberg.png{% endif %}' property='og:image'/>
	<meta content='{{ meta.description|striptags }}' property='og:description'/>
	<meta content='{{ site_title }}' property='og:site_name'/>
	<meta content='en_US' property='og:locale'/>
	<meta content='summary_large_image' name='twitter:card'/>
	<meta content='{{ meta.title }}' name='twitter:title'/>
	<meta content='{{ meta.description|striptags }}' name='twitter:description'/>
	<meta content='{% if meta.img %}{{ meta.img }}{% else %}{{ theme_url }}/img/iceberg.png{% endif %}' name='twitter:image'/>
    <!-- Bootstrap Core CSS -->
    <link href="{{ theme_url }}/css/bootstrap.min.css" rel="stylesheet">

    <!-- Custom CSS -->
    <link href="{{ theme_url }}/css/clean-blog.css" rel="stylesheet">
    <link href="{{ theme_url }}/css/modal-images.css" rel="stylesheet">
    <link href="{{ theme_url }}/css/easymde.min.css" rel="stylesheet">

    <!-- Custom Fonts -->
    <link href="{{ theme_url }}/css/font-awesome.css" rel="stylesheet" type="text/css">
    <link href='https://fonts.googleapis.com/css?family=Lora:400,700,400italic,700italic' rel='stylesheet' type='text/css'>
    <link href='https://fonts.googleapis.com/css?family=Open+Sans:300italic,400italic,600italic,700italic,800italic,400,300,600,700,800' rel='stylesheet' type='text/css'>

    <script src="{{ theme_url }}/js/jquery.min.js"></script>
    <script src="{{ theme_url }}/js/bootstrap.min.js"></script>
    <script src="{{ theme_url }}/js/easymde.min.js"></script>
    <script src="{{ theme_url }}/js/clean-blog.js"></script>

</head>

<body>

	{% if meta.toc %}
		{{ toc }}
	{% endif %}

    <!-- Navigation -->
    <nav class="navbar navbar-default navbar-custom navbar-fixed-top">
        <div class="container-fluid">
            <!-- Brand and toggle get grouped for better mobile display -->
            {% set num_pages = paged_pages|length %}
            {% if num_pages>0 %}
            <div class="navbar-header page-scroll">
                <a class="navbar-brand-post" href="{{ base_url }}">Home</a>
            </div>
            {% endif %}

            <!-- /.navbar-collapse -->
        </div>
        <!-- /.container -->
    </nav>

    <!-- Page Header -->
    <!-- Set your background image for this header on the line below. -->
    <header class="post-header">
        <div class="container">
            <div class="row">
                <div class="col-lg-10 col-lg-offset-1 col-md-10 col-md-offset-1">
                    <div class="post-heading">
                        <h1>{{ meta.title }}</h1>
                        <h2 class="subheading">{{ meta.description }}</h2>
												{% if has_search_page %}
                        <div class="meta">Posted by <a href="{{ base_url }}/search/author:{{ meta.author }}">{{ meta.displayname }}</a> on {{ meta.date }}</div>
												{% endif %}
												{% if meta.labels and has_search_page %}
		                    <div class="labels">
		                    	{% set labels = meta.labels is iterable ? meta.labels : meta.labels|split(',') %}
		                    	{% for label in labels %}
		   									 		<a href="{{ base_url }}/search/labels:{{ label }}"><span class="label">{{ label }}</span></a>
													{% endfor %}
		                    </div>
                    		{% endif %}
                    		{% if has_search_page %}
													<div id="displayavatar">
										 				<a href="{{ base_url }}/search/author:{{ meta.author }}">
															<img class="avatardiv" src="{{ nc_root }}/index.php/avatar/{{ meta.author|lower|trim }}/64" alt="{{ meta.author }}" onerror="var s=document.createElement('span');s.className=this.className;s.textContent='{{ meta.author|first|upper }}';this.parentNode.replaceChild(s,this)" />
														</a>
													</div>
												{% endif %}
                    </div>
                </div>
            </div>
        </div>
   			{% if meta.access != 'public' and editable is not empty %}
	        <button class="edit-button btn btn-primary btn-flat" path="{{ oc_path }}"
	        dir_id="{{ oc_parent_id }}" id="{{ oc_id }}"
	        user="{{ oc_user }}" owner="{{ oc_owner }}" group="{{ oc_group }}"
	        host="{{ oc_user_home_url }}">Edit</button>
        {% endif %}
    </header>
    
    <hr class="small">

    <!-- Post Content -->
    <article>
        <div class="container">
            <div class="row">
                <div class="col-lg-10 col-lg-offset-1 col-md-10 col-md-offset-1">
					{{ content }}
                </div>
            </div>
        </div>
    </article>
    
      <div class="col-lg-8">
        <a id="show_comments">Comments <span class="laquo">&laquo;</span><span class="raquo">&raquo;</span></a>
      </div>

    <comments>
    <div class="container">
	    <div class="col-lg-offset-2">
		    <div class="form-group col-xs-5 comment-post"
		    share="{{  oc_share }}" path="{{  oc_path }}" owner="{{  oc_owner }}" user="{{  oc_user }}" host="{{ oc_user_home_url }}"
		    group="{{  oc_group }}">
		     <input placeholder="Your name" type="text" class="form-control" id="name" size="64" value="{{ oc_full_name }}" />
		     <textarea placeholder="Your comment" class="form-control" rows="3" id="comment"></textarea>
		     <button id="submit_comment" class="btn btn-default btn-small">Submit</button>
		    </div>
		
		    <!-- Comments -->
		    <div id="comments" class="col-md-10">
		    </div>
		  </div>
	  </div>
    </comments>
    
    <p />
    <hr class="foot">

    <!-- Footer -->
    <footer>
        <div class="container">
            <div class="row">
                <div class="col-lg-10 col-lg-offset-1 col-md-10 col-md-offset-1">
                    <ul class="list-inline text-center">
                        <li>
                            <a href="https://twitter.com/home?status={{ current_page.url }}" target="_blank" rel="noopener noreferrer">
                                <span class="fa-stack fa-lg">
                                    <i class="fa fa-circle fa-stack-2x"></i>
                                    <i class="fa fa-twitter fa-stack-1x fa-inverse"></i>
                                </span>
                            </a>
                        </li>
                        <li>
                            <a href="https://www.facebook.com/sharer/sharer.php?u={{ current_page.url }}" target="_blank" rel="noopener noreferrer">
                                <span class="fa-stack fa-lg">
                                    <i class="fa fa-circle fa-stack-2x"></i>
                                    <i class="fa fa-facebook fa-stack-1x fa-inverse"></i>
                                </span>
                            </a>
                        </li>
                        <li>
                            <a href="https://www.linkedin.com/shareArticle?mini=true&url={{ current_page.url }}" target="_blank" rel="noopener noreferrer">
                                <span class="fa-stack fa-lg">
                                    <i class="fa fa-circle fa-stack-2x"></i>
                                    <i class="fa fa-linkedin fa-stack-1x fa-inverse"></i>
                                </span>
                            </a>
                        </li>
                    </ul>
                    <p class="copyright text-muted">Copyright &copy; {{ site_title }} {{ "now"|date("Y") }}</p>
                </div>
            </div>
        </div>
    </footer>


</body>

</html>
