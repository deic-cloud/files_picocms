<!DOCTYPE html>
{% set nc_root = base_url|split('/remote.php')|first %}
<html lang="en">

<head data-requesttoken="{{ config.requesttoken }}">

    <link rel="alternate" type="application/rss+xml" title="RSS Feed" href="{{ base_url }}/rss" />

    <base href="{{ base_url }}/">
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="{{ meta.description|striptags }}">
    <meta name="author" content="{{ config.author }}">

    <title>{{ site_title }}</title>
	<meta content='{{ site_title }}' property='og:title'/>
	<meta content='website' property='og:type'/>
	<meta content='{{ current_page.url }}' property='og:url'/>
	<meta content='{% if meta.icon %}{{ meta.icon }}{% endif %}' property='og:image'/>
	<meta content="{{ meta.description|striptags }}" property='og:description'/>
	<meta content='{{ site_title }}' property='og:site_name'/>
	<meta content='en_US' property='og:locale'/>
	<meta content='summary_large_image' name='twitter:card'/>
	<meta content='{{ site_title }}' name='twitter:title'/>
	<meta content='{{ meta.description|striptags }}' name='twitter:description'/>
	<meta content='{% if meta.icon %}{{ meta.icon }}{% endif %}' name='twitter:image'/>
    <!-- Bootstrap Core CSS -->
    <link href="{{ theme_url }}/css/bootstrap.min.css" rel="stylesheet">

    <!-- Custom CSS -->
    <link href="{{ theme_url }}/css/blog.css" rel="stylesheet">
    <link href="{{ theme_url }}/css/easymde.min.css" rel="stylesheet">

    <!-- Custom Fonts -->
    <link href="{{ theme_url }}/css/font-awesome.css" rel="stylesheet" type="text/css">
    <link href='https://fonts.googleapis.com/css?family=Lora:400,700,400italic,700italic' rel='stylesheet' type='text/css'>
    <link href='https://fonts.googleapis.com/css?family=Open+Sans:300italic,400italic,600italic,700italic,800italic,400,300,600,700,800' rel='stylesheet' type='text/css'>

    <script src="{{ theme_url }}/js/jquery.min.js"></script>
    <script src="{{ theme_url }}/js/bootstrap.min.js"></script>
    <script src="{{ theme_url }}/js/easymde.min.js"></script>
    <script src="{{ theme_url }}/js/blog.js"></script>
    {% if config.icon %}<link rel="shortcut icon" href="{{ base_url }}/{{ config.icon }}" />{% elseif config.favicon %}<link rel="shortcut icon" href="{{ base_url }}/{{ config.favicon }}" />{% else %}<link rel="shortcut icon" href="{{ theme_url }}/img/data_icon.png" />{% endif %}
</head>

<body>
	<!-- Navigation -->
    <nav class="navbar navbar-default navbar-custom navbar-fixed-top">
        <div class="container-fluid">
            <!-- Brand and toggle get grouped for better mobile display -->
						{% if page_number > 1 %}
							<div class="navbar-header page-scroll">
									<a class="navbar-brand" href="{{ base_url }}">Home</a>
							</div>
						{% endif %}
            <!-- /.navbar-collapse -->
            {% if has_search_page %}
							<form class = "navbar-search" id="search_form" action="{{ base_url  }}/search">
								<input type="search" id="search_input" name="q" placeholder="Search" />
							</form>
						{% endif %}
						<div class="navbar-header page-scroll navbar-right">
						{% if has_search_page %}
							<a class="navbar-brand search" href="{{ base_url }}/search">Search</a>
						{% endif %}
						{% if meta.about %}
							<div class="about"><a href="about">About</a></div>
						{% endif %}
						</div>
        </div>
        <!-- /.container -->
    </nav>
    <!-- Page Header -->
    <!-- Set your background image for this header on the line below. -->
    <header class="intro-header" style="{% if meta.img %}background-image: url({{ meta.img }});
    {% else %}background: #006286;{% endif %}">
        <div class="container">
            <div class="row">
                <div class="col-lg-8 col-lg-offset-2 col-md-10 col-md-offset-1">
                    <div class="site-heading">
                        <h1>
                        <a href="{{ base_url }}">
                        {{ site_title }}
                        {% if meta.icon %}<img class="header-icon" src="{{ meta.icon }}" />{% endif %}
                        </a>
                        <a href="{{ base_url }}" target="_top" class="popout hidden">
                        	<i title="Pop out" class="icon icon-fullscreen icon-white"></i>
                        </a>
                        </h1>
                        <hr class="thin">
                        <span class="subheading">{{ meta.tagline }}</span>
                    </div>
                </div>
            </div>
        </div>

        <a class="navbar-left write-post" share="{{ oc_share }}" path="{{ oc_path }}"
        dir_id="{{ oc_parent_id }}" id="{{ oc_id }}"
        style="display:none;"
            owner="{{  oc_owner }}" user="{{ oc_user }}" group="{{ oc_group }}"
            host="{{ oc_cms_base }}" readable="{{ readable }}" editable="{{ editable }}" writable="{{ writable }}">Write</a>
        <input id="write_post" type="text" placeholder="New post title…"
            style="display:none;position:absolute;left:20px;width:300px;padding:6px 10px;font-size:14px;border-radius:4px;border:1px solid #ccc;" />

    </header>

    <!-- Main Content -->
    <div class="container">
        <div class="row">
            <div class="col-lg-8 col-lg-offset-2 col-md-10 col-md-offset-1">
      {% set num_pages = paged_pages|length %}
      {% set i = 0 %}
			{% for page in paged_pages %}
      {% set i = i + 1 %}
				<div class="post-preview">
									{% if has_search_page %}
                   <a href="{{ base_url }}/search/author:{{ page.author }}"><img class="avatardiv" src="{{ nc_root }}/index.php/avatar/{{ page.author|lower|trim }}/64" alt="{{ page.author }}" onerror="var s=document.createElement('span');s.className=this.className;s.textContent='{{ page.author|first|upper }}';this.parentNode.replaceChild(s,this)" /></a>
                  {% endif %}
                  <a id= "{{ page.id }}" href="{{ page.url }}">
                        <h2 class="post-title">
							{{ page.title }}
                        </h2>
                        <h3 class="post-subtitle">
							{{ page.description }}
                        </h3>
                    </a>
                    {% if num_pages>1 %}
                    <p class="post-meta">Posted by{% if has_search_page %} <a href="{{ base_url }}/search/author:{{ page.author }}">{{ page.meta.displayname }}</a>{% else %} {{ page.meta.displayname }}{% endif %} on&nbsp;{{ page.date }}</p>
                    {% endif %}
                    {% if page.meta.labels and has_search_page %}
                    <div class="labels">
                    	{% set labels = page.meta.labels is iterable ? page.meta.labels : page.meta.labels|split(',') %}
                    	{% for label in labels %}
   									 		<a href="{{ base_url }}/search/labels:{{ label }}"><span class="label">{{ label }}</span></a>
											{% endfor %}
                    </div>
                    {% endif %}
                    {% if page.meta.indeximage %}
                    <a href="{{ page.url }}">
                    <img class="indexImage" src="{{ page.meta.indeximage }}"/>
                    </a>
                    {% endif %}
                </div>
							{% if i < num_pages %}
                <hr>
							{% endif %}
            {% endfor %}
                <!-- Pager -->
                <ul class="pager">
					{% if page_number > 1 %}
					<li class="previous">
                        <a href="{{ base_url }}/{{ page_indicator }}/{{ page_number - 1 }}">&larr; Newer Posts</a>
                    </li>
					{% endif %}

					{% if page_number < total_pages %}
                    <li class="next">
                        <a href="{{ base_url }}/{{ page_indicator }}/{{ page_number + 1 }}">Older Posts &rarr;</a>
                    </li>
					{% endif %}
                </ul>
            </div>
        </div>
    </div>

    <hr>

    <!-- Footer -->
    <footer>
        <div class="container">
            <div class="row">
                <div class="col-lg-8 col-lg-offset-2 col-md-10 col-md-offset-1">
                    <ul class="list-inline text-center">
					{% for link,icon in meta.social %}
                        <li>
                            <a href="{{ link }}" target="_blank" rel="noopener noreferrer">
                                <span class="fa-stack fa-lg">
                                    <i class="fa fa-circle fa-stack-2x"></i>
                                    <i class="fa fa-{{ icon }} fa-stack-1x fa-inverse"></i>
                                </span>
                            </a>
                        </li>
					{% endfor %}
                    </ul>
                    <p class="copyright text-muted">Copyright &copy; {{ site_title }}&nbsp;{{ "now"|date("Y") }}</p>
                </div>
            </div>
        </div>
    </footer>

</body>
</html>
