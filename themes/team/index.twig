<!DOCTYPE html>
{% set nc_root = base_url|split('/remote.php')|first %}
<html lang="en">

<head data-requesttoken="{{ config.requesttoken }}">

	<meta charset="utf-8">
	<meta http-equiv="X-UA-Compatible" content="IE=edge">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<meta name="description" content="{{ meta.description|striptags }}">
	<meta name="author" content="{{ config.author }}">

	<title>{{ site_title }}{% if meta.title %} | {{ meta.title }}{% endif %}</title>
	<meta content='{{ site_title }}' property='og:title'/>
	<meta content='website' property='og:type'/>
	<meta content='{{ current_page.url }}' property='og:url'/>
	<meta content='{% if meta.img %}{{ meta.img }}{% else %}{{ theme_url }}/img/home.jpg{% endif %}' property='og:image'/>
	<meta content="{{ meta.description|striptags }}" property='og:description'/>
	<meta content='{{ site_title }}' property='og:site_name'/>
	<meta content='en_US' property='og:locale'/>
	<meta content='summary_large_image' name='twitter:card'/>
	<meta content='{{ site_title }}' name='twitter:title'/>
	<meta content='{{ meta.description|striptags }}' name='twitter:description'/>
	<meta content='{% if meta.img %}{{ meta.img }}{% else %}{{ theme_url }}/img/home.jpg{% endif %}' name='twitter:image'/>

	<link href="{{ theme_url }}/css/bootstrap.css" rel="stylesheet">
	<link href="{{ theme_url }}/css/team.css" rel="stylesheet">
	<link href="{{ theme_url }}/css/modal-images.css" rel="stylesheet">
	<link href="{{ theme_url }}/css/easymde.min.css" rel="stylesheet">
	<link href="{{ theme_url }}/css/font-awesome.css" rel="stylesheet" type="text/css">
	<link href="{{ theme_url }}/css/fonts.css" rel="stylesheet" type="text/css">

	<script>window.MathJax = { tex: { inlineMath: [['$','$'], ['\\(','\\)']] } };</script>
	<script src="{{ base_url }}/mathjax/tex-mml-chtml.js" async></script>
	<script src="{{ theme_url }}/js/jquery.min.js"></script>
	<script src="{{ theme_url }}/js/bootstrap.min.js"></script>
	<script src="{{ theme_url }}/js/easymde.min.js"></script>
	<script src="{{ theme_url }}/js/team.js"></script>

	{% if config.favicon %}<link id="favicon" rel="shortcut icon" type="image/png" href="{{ base_url }}/{{ config.favicon }}" />{% elseif config.icon %}<link id="favicon" rel="shortcut icon" type="image/png" href="{{ base_url }}/{{ config.icon }}" />{% else %}<link id="favicon" rel="shortcut icon" type="image/png" href="{{ theme_url }}/img/data_icon.png" />{% endif %}
</head>

<body>
	<!-- Navigation -->
	<nav class="navbar navbar-default navbar-custom navbar-fixed-top">
		<div class="container-fluid page-nav">
			<span class="nav">
				<a id="home" title="Home" href="{{ base_url }}"><img alt="Home" src="{% if config.icon %}{{ base_url }}/{{ config.icon }}{% else %}{{ theme_url }}/img/data_icon.png{% endif %}" class="icon" /></a>
			</span>
			<div class="icon nav menu" title="Folders"><i class="fa fa-bars"></i></div>
			<div class="icon nav labels" title="Labels"><i class="fas fa-tags"></i></div>
			{% if has_search_page %}
				<form class = "navbar-search" id="search_form" action="{{ base_url  }}/search">
					<input type="search" id="search_input" name="q" placeholder="Search" />
					<!--<input type="submit" id="search_submit" value="Search" />-->
				</form>
			{% endif %}
			{% if editable is not empty or writable is not empty %}
				<div class="write-post" share="{{ oc_share }}" path="{{ oc_path }}" host="{{ oc_cms_base }}"
					dir_id="{{ oc_parent_id }}" id="{{ oc_id }}" owner="{{  oc_owner }}" user="{{ oc_user }}"
					user_home_url="{{ oc_user_home_url }}"  group="{{  oc_group }}" title="Create new page">
					<img class="icon" src="{{ theme_url }}/img/new-document.png" />
				</div>
				<input type="search" id="write_post" name="q" placeholder="Title" />
				<input id="upload_file" type="file">
				<div class="upload" share="{{ oc_share }}" path="{{ oc_path }}" host="{{ oc_cms_base }}"
					dir_id="{{ oc_parent_id }}" id="{{ oc_id }}" owner="{{  oc_owner }}" user="{{ oc_user }}"
					user_home_url="{{ oc_user_home_url }}"  group="{{  oc_group }}" title="Upload file">
					<img class="icon" src="{{ theme_url }}/img/upload.png" />
				</div>
			{% endif %}
		</div>
	</nav>

	<ul class="leftbar">
		{% for fol in found_folders|default([])|sort %}
		{% if fol != "/" %}
			{% set depth = fol | split('/') | length -1 %}
			{% set name = (fol | split('/'))[ depth - 1 ] %}
				<li class="toc toc{{ depth }} nav{% if fol == current_page.folder %} active{% endif %}">
						<a href="{{ base_url  }}/{{ fol }}?index=1">{{ name}}/</a>
				</li>
		{% endif %}
		{% endfor %}
	</ul>

	<ul class="labelsbar">
		{% for label in labels|default([])|sort %}
			{% set label = label|trim %}
			<li class="nav">
				<a href="{{ base_url }}/search/labels:{{ label }}">{{ label }}</a>
			</li>
		{% endfor %}
	</ul>

	{% if (editable is not empty or writable is not empty) and not current_page.id is empty %}
		<button title="Edit page" class="edit-button float-button" host="{{ oc_cms_base }}"
		path="{{ oc_path }}{% if current_page.id ends with 'index' and oc_path ends with '/' %}index.md{% endif %}"
		dir_id="{{ oc_parent_id }}" id="{{ oc_id }}"
		user="{{ oc_user }}" user_home_url="{{ oc_user_home_url }}" owner="{{ oc_owner }}"
		group="{{ oc_group }}"><i class="fa fa-pencil-alt"></i></button>
	{% endif %}
	
	{% if current_page.folder != "/" %}
		<button title="Parent" class="parent-button float-button">..</button>
	{% endif %}

	<!-- Main Content -->
	<div class="container viewcontainer">
		<div class="row">
			<div class="col-lg-10 col-lg-offset-1 col-md-10 col-md-offset-1">

			{% if search_query is not empty %}
				{# Search results view — show a heading instead of the page content #}
				{% set sq_parts = search_query|split(':', 2) %}
				{% set sq_first = paged_pages|first %}
				<h2 class="search-results-heading">
					{%- if sq_parts[0] == 'labels' -%}
						Posts labelled <span class="label">{{ sq_parts[1] }}</span>
					{%- elseif sq_parts[0] == 'author' -%}
						{{ 'Posts and pages by ' ~ (sq_first ? sq_first.meta.displayname|default(sq_parts[1]) : sq_parts[1]) }}
					{%- else -%}
						Search results for “{{ sq_parts[1] }}”
					{%- endif -%}
				</h2>
				{% if not sq_first %}<p>No matching posts.</p>{% endif %}
			{% else %}

			{% if meta.labels and has_search_page %}
				<div class="labels">
					{% set mylabels = meta.labels|split(',') %}
					{% for label in mylabels %}
						{% set label = label|trim %}
							<a href="{{ base_url }}/search/labels:{{ label }}"><span class="label">{{ label }}</span></a>
					{% endfor %}
				</div>
			{% endif %}

			{{ content }}

			<!-- File editor -->
			<div id="content"><div id="controls"><div id="notification"></div></div></div>

			{% endif %}

			<!-- If no page requested, generate index. Search results (the
			     search/author:… and search/labels:… URLs rewrite to this
			     template) always render, using the query-filtered list. -->
			{% set i = 0 %}
			{# Index: true parses as a YAML boolean — compare strictly: the loose
			   `true != "false"` is false in PHP/Twig and hid the listing. #}
			{% if search_query is not empty
				or (meta.redable and not current_page.id)
				or current_page.meta.index is same as(true)
				or (current_page.meta.index is not empty
					and current_page.meta.index is not same as(false)
					and current_page.meta.index != "false"
					and current_page.meta.index != "no") %}
			<div id="dir_index">
				{% set listing = search_query is not empty ? paged_pages : pages|sort_by("time")|reverse %}
				{% for page in listing if page.title and
				( page.template == "post" or page.template == "page" ) and
				( search_query is not empty or page.folder == folder or folder == "/" ) %}
					{% set i = i + 1 %}
					<div class="post-preview">
						{% if has_search_page and page.template == "post" %}
							<a href="{{ base_url }}/search/author:{{ page.author }}"><div class="avatardiv" author="{{ page.author }}"></div></a>
						{% endif %}
						<a href="{{ page.url }}">
							<h3 class="post-title">
								{{ page.title }}
							</h3>
							<h4 class="post-subtitle">
								{{ page.description }}
							</h4>
						</a>
						{# Whitespace before tags is trimmed by this Twig setup — keep
						   the separating space inside the expression. #}
						<p class="post-meta">{{ page.date ? page.date ~ ', ' : '' }}{% if has_search_page and page.template != "post" %}<a href="{{ base_url }}/search/author:{{ page.author }}">{{ page.meta.displayname|default(page.author) }}</a>{% else %}{{ page.meta.displayname|default(page.author) }}{% endif %}</p>
						{% if page.meta.labels and has_search_page %}
							<div class="labels">
								{% set mylabels = page.meta.labels|split(',') %}
								{% for label in mylabels %}
										<a href="{{ base_url }}/search/labels:{{ label }}"><span class="label">{{ label }}</span></a>
								{% endfor %}
							</div>
						{% endif %}
					</div>
					<hr />
				{% endfor %}
				<!-- Pager -->
				<ul class="pager">
					{% if page_number > 1 %}
					<li class="previous">
						<a href="{{ base_url }}/{{ page_indicator }}/{{ page_number - 1 }}">&larr; Newer Posts</a>
					</li>
					{% endif %}
					
					{% if page_number < total_pages %} 
					<li class="next">
						<a href="{{ base_url }}/{{ page_indicator }}/{{ page_number + 1 }}">Older Posts &rarr;</a>
					</li>
					{% endif %}
				</ul>
			</div>
			{% endif %}
			</div>
		</div>
	</div>

{% if i == 0 %}
	<hr />
{% endif %}

	<!-- Footer -->
	<footer>
		<div class="container">
			<div class="row">
				<div class="col-lg-10 col-lg-offset-1 col-md-10 col-md-offset-1">
					<ul class="list-inline text-center">
					{% for link,icon in meta.social %}
						<li>
							<a href="{{ link }}" target="_blank" rel="noopener noreferrer">
								<span class="fa-stack fa-lg">
									<i class="fa fa-circle fa-stack-2x"></i>
									<i class="fab fa-{{ icon }} fa-stack-1x fa-inverse"></i>
								</span>
							</a>
						</li>
					{% endfor %}
					</ul>
					<p class="copyright text-muted">Copyright &copy; {{ site_title }}&nbsp;{{ "now"|date("Y") }}</p>
				</div>
			</div>
		</div>
	</footer>
</body>
</html>