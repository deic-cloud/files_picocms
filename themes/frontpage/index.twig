<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>{{ site_title }}{% if meta.title %} — {{ meta.title }}{% endif %}</title>
	{% if meta.description %}<meta name="description" content="{{ meta.description|striptags }}">{% endif %}
	<link rel="stylesheet" href="{{ theme_url }}/css/style.css" />
	{% if config.icon %}<link rel="icon" href="{{ base_url }}/{{ config.icon }}" />{% endif %}
</head>
<body>

{# --- Full-window hero with rotating background ------------------------------
   Danish landscapes carried over from the old sciencedata.dk theme. Add/remove by
   editing this list and dropping files in themes/frontpage/img/backgrounds/. Images
   are LAZY-loaded (only the visible one is fetched, then the next just before it
   crossfades in) so the set can grow without slowing the page. #}
{% set backgrounds = [
	'peberholm.jpg', 'skagen.jpg', 'moens_klint.jpg', 'disko-bugten.jpg',
	'rubjerg_knude.jpg', 'raps.jpg', 'nordlys.jpg', 'helligdomsklipperne.jpg',
	'hvedemark.jpg', 'rebild_bakker.jpg', 'esbjerg.jpg', 'fyns_hoved.jpg',
	'hvidesande.jpg', 'loekken.jpg', 'markvej.jpg', 'sandvig.jpg',
	'sorvagsvatn.jpg', 'storebaeltsbroen.jpg'
] %}

<section class="hero">
	<div class="hero-bg">
		<div class="slide layer-a"></div>
		<div class="slide layer-b"></div>
	</div>

	<header class="site-head">
		<a class="brand" href="{{ base_url }}">ScienceData</a>
		<nav class="site-nav">
			<a href="/sites/blog">Blog</a>
			<a href="/sites/documentation">Documentation</a>
			<a href="/sites/terms">Terms</a>
			{% if config.sd_logged_in %}
				<a href="{{ config.sd_files_url }}">Your files</a>
			{% else %}
				<a href="{{ config.sd_login_url }}">Log in</a>
			{% endif %}
		</nav>
	</header>

	<div class="hero-inner">
		<h1>{% if meta.title %}{{ meta.title }}{% else %}{{ site_title }}{% endif %}</h1>
		{% if meta.tagline %}<p class="tagline">{{ meta.tagline }}</p>{% endif %}
		<div class="hero-actions">
			{% if config.sd_logged_in %}
				<a class="btn btn-primary btn-lg" href="{{ config.sd_files_url }}">Go to your files</a>
			{% else %}
				<a class="btn btn-primary btn-lg" href="{{ config.sd_login_url }}">Log in</a>
			{% endif %}
			<a class="btn btn-ghost btn-lg" href="/sites/documentation">Read the docs</a>
		</div>
	</div>

	<a class="scroll-cue" href="#more" aria-label="Scroll down"><span></span></a>
</section>

<a id="more"></a>

{% if config.sd_stats %}
<section class="pulse">
	<div class="pulse-inner">
		<div class="stat"><span class="num">{{ config.sd_stats.researchers }}</span><span class="label">researchers</span></div>
		<div class="stat"><span class="num">{{ config.sd_stats.institutions }}</span><span class="label">institutions</span></div>
		<div class="stat"><span class="num">{{ config.sd_stats.groups }}</span><span class="label">groups</span></div>
		<div class="stat"><span class="num">{{ config.sd_stats.public_datasets }}</span><span class="label">public datasets</span></div>
	</div>
</section>
{% endif %}

{# --- Body H2 sections rendered as responsive cards (3 cols → 1 col) --------- #}
<main class="content">
	<div class="cards">
		{# Split the Markdown body's H2 sections into cards. Pico gives headings id
		   attributes (<h2 id="...">), so split on "<h2" and drop the opening tag. #}
		{% for chunk in content|split('<h2') %}
			{% if '</h2>' in chunk %}
				{% set rest  = chunk|split('>', 2)[1] %}
				{% set parts = rest|split('</h2>', 2) %}
				<article class="card">
					<h3>{{ parts[0]|striptags }}</h3>
					<div class="card-body">{{ parts[1]|raw }}</div>
				</article>
			{% endif %}
		{% endfor %}
	</div>
</main>

{% if config.sd_stats and config.sd_stats.institution_list is not empty %}
<section class="institutions">
	<div class="institutions-inner">
		<h2>Researchers from</h2>
		<ul class="inst-list">
			{% for inst in config.sd_stats.institution_list %}<li>{{ inst }}</li>{% endfor %}
		</ul>
	</div>
</section>
{% endif %}

<footer class="site-foot">
	<div class="foot-inner">
		<span>ScienceData — i2, Technical University of Denmark (DTU)</span>
		<nav>
			<a href="/sites/blog">Blog</a>
			<a href="/sites/documentation">Documentation</a>
			<a href="/sites/terms">Terms</a>
			{% if not config.sd_logged_in %}<a href="{{ config.sd_login_url }}">Log in</a>{% endif %}
		</nav>
	</div>
</footer>

<script>
(function () {
	var imgs = [{% for bg in backgrounds %}"{{ theme_url }}/img/backgrounds/{{ bg }}"{% if not loop.last %},{% endif %}{% endfor %}];
	var a = document.querySelector('.hero-bg .layer-a');
	var b = document.querySelector('.hero-bg .layer-b');
	if (!a || !b || !imgs.length) return;

	// Show the first image immediately; it is the only one fetched on load.
	a.style.backgroundImage = "url('" + imgs[0] + "')";
	a.classList.add('active');
	if (imgs.length < 2) return;

	var layers = [a, b], cur = 0, idx = 0;
	setInterval(function () {
		var next = (idx + 1) % imgs.length;
		var hidden = layers[(cur + 1) % 2];
		var pre = new Image();          // lazy: fetch the next image just in time
		pre.onload = function () {
			hidden.style.backgroundImage = "url('" + imgs[next] + "')";
			hidden.classList.add('active');
			layers[cur].classList.remove('active');
			cur = (cur + 1) % 2;
			idx = next;
		};
		pre.src = imgs[next];
	}, 7000);
})();
</script>

</body>
</html>
