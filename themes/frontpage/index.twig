<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	{% set brand = config.sd_brand_name|default('Nextcloud') %}
	<title>{{ meta.title ? brand ~ ' — ' ~ meta.title : brand }}</title>
	{% if meta.description %}<meta name="description" content="{{ meta.description|striptags }}">{% endif %}
	{% set static_base = config.sd_theme_static|default(theme_url) %}
	<link rel="stylesheet" href="{{ static_base }}/css/style.css?v={{ config.sd_asset_ver|default('1') }}" />
	{% if config.icon %}<link rel="icon" href="{{ base_url }}/{{ config.icon }}" />{% else %}<link rel="icon" href="{{ static_base }}/img/favicon.svg" type="image/svg+xml" />{% endif %}
</head>
<body>

{# Persistent top bar: transparent over the hero, solid once scrolled.
   Stays fixed so "Your files" / "Log in" is always one click away. #}
<header class="site-head" id="siteHead">
	<a class="brand" href="{{ base_url }}">{{ config.sd_brand_html|default(brand)|raw }}</a>
	<nav class="site-nav">
		<a href="/sites/blog">Blog</a>
		<a href="/sites/documentation">Documentation</a>
		<a href="/sites/terms">Terms</a>
		{% if config.sd_logged_in %}
			<a class="nav-cta" href="{{ config.sd_files_url }}">Your files</a>
		{% else %}
			<a class="nav-cta" href="{{ config.sd_login_url }}">Log in</a>
		{% endif %}
	</nav>
</header>

{# --- Full-window hero with lazy-loaded rotating background ------------------
   Danish landscapes from the old sciencedata.dk theme. Edit this list and drop
   files in themes/frontpage/img/backgrounds/. Only the visible image is fetched;
   the next is fetched just before it crossfades in, so the set stays light. #}
{% set backgrounds = [
	'peberholm.jpg', 'skagen.jpg', 'moens_klint.jpg', 'disko-bugten.jpg',
	'rubjerg_knude.jpg', 'raps.jpg', 'nordlys.jpg', 'helligdomsklipperne.jpg',
	'hvedemark.jpg', 'rebild_bakker.jpg', 'esbjerg.jpg',
	'hvidesande.jpg', 'loekken.jpg', 'markvej.jpg',
	'sorvagsvatn.jpg', 'storebaeltsbroen.jpg'
] %}

<section class="hero">
	<div class="hero-bg">
		<div class="slide layer-a"></div>
	</div>

	<div class="hero-inner">
		<h1>{% if meta.title %}{{ meta.title }}{% else %}{{ site_title }}{% endif %}</h1>
		{% if meta.tagline %}<p class="tagline">{{ meta.tagline }}</p>{% endif %}
		<div class="hero-actions">
			{% if config.sd_logged_in %}
				<a class="btn btn-primary btn-lg" href="{{ config.sd_files_url }}">Go to your files</a>
			{% else %}
				<a class="btn btn-primary btn-lg" href="{{ config.sd_login_url }}">Log in</a>
			{% endif %}
			<a class="btn btn-ghost btn-lg" href="/sites/documentation">Read the docs</a>
		</div>
	</div>

	<a class="scroll-cue" href="#more" aria-label="Scroll down"><span></span></a>
</section>

<a id="more"></a>

{% if config.sd_stats %}
<section class="pulse">
	<div class="pulse-inner">
		<div class="stat"><span class="num">{{ config.sd_stats.researchers }}</span><span class="label">researchers</span></div>
		<div class="stat"><span class="num">{{ config.sd_stats.institutions }}</span><span class="label">institutions</span></div>
		<div class="stat"><span class="num">{{ config.sd_stats.groups }}</span><span class="label">groups</span></div>
		<a class="stat stat-link" href="{{ config.sd_catalog_url|default('/remote.php/sites/public/') }}"><span class="num">{{ config.sd_stats.public_datasets }}</span><span class="label">public datasets</span></a>
	</div>
</section>
{% endif %}

{# Body H2 sections → responsive cards (3 cols → 1). Split tolerates <h2 id="…">. #}
<main class="content">
	<div class="cards">
		{% for chunk in content|split('<h2') %}
			{% if '</h2>' in chunk %}
				{% set rest  = chunk|split('>', 2)[1] %}
				{% set parts = rest|split('</h2>', 2) %}
				<article class="card">
					<h3>{{ parts[0]|striptags }}</h3>
					<div class="card-body">{{ parts[1]|raw }}</div>
				</article>
			{% endif %}
		{% endfor %}
	</div>
</main>

{% if config.sd_catalog is not empty %}
<section class="catalog">
	<div class="catalog-inner">
		<h2>Public datasets <a class="catalog-all" href="{{ config.sd_catalog_url|default('/remote.php/sites/public/') }}">See all →</a></h2>
		<p class="catalog-sub">Folders their owners chose to share openly.</p>
		<ul class="catalog-list">
			{% for d in config.sd_catalog %}
			<li class="dataset">
				<a class="dataset-link" href="{{ d.url }}">{{ d.title }}</a>
				{% if d.institution %}<span class="dataset-inst">{{ d.institution }}</span>{% endif %}
			</li>
			{% endfor %}
		</ul>
	</div>
</section>
{% endif %}

{% if config.sd_stats and config.sd_stats.institution_list is not empty %}
<section class="institutions">
	<div class="institutions-inner">
		<h2>Researchers from</h2>
		<ul class="inst-list">
			{% for inst in config.sd_stats.institution_list %}<li>{{ inst }}</li>{% endfor %}
		</ul>
	</div>
</section>
{% endif %}

<footer class="site-foot">
	<div class="foot-inner">
		<span>ScienceData — i2, Technical University of Denmark (DTU)</span>
		<a href="mailto:support@sciencedata.dk">support@sciencedata.dk</a>
	</div>
</footer>

<script>
(function () {
	// Persistent header: solid once scrolled off the hero.
	var head = document.getElementById('siteHead');
	function onScroll() {
		if (window.scrollY > 40) { head.classList.add('scrolled'); }
		else { head.classList.remove('scrolled'); }
	}
	window.addEventListener('scroll', onScroll, { passive: true });
	onScroll();

	// Slow smooth-scroll: down-arrow glides to the content; the brand glides
	// back to the top. (~1.4s, ease-in-out — deliberately gentler than the
	// browser default.)
	function ease(t) { return t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2; }
	function scrollToY(targetY, duration) {
		var startY = window.pageYOffset, dist = targetY - startY, start = null;
		if (Math.abs(dist) < 2) return;
		function step(ts) {
			start = start || ts;
			var p = Math.min((ts - start) / duration, 1);
			window.scrollTo(0, startY + dist * ease(p));
			if (p < 1) { requestAnimationFrame(step); }
		}
		requestAnimationFrame(step);
	}
	var cue = document.querySelector('.scroll-cue');
	if (cue) { cue.addEventListener('click', function (e) {
		e.preventDefault();
		var t = document.getElementById('more');
		if (t) { scrollToY(t.offsetTop, 1400); }
	}); }
	var brand = document.querySelector('.brand');
	if (brand) { brand.addEventListener('click', function (e) {
		e.preventDefault();
		scrollToY(0, 1400);
	}); }

	// One background per page load, chosen at random; changes only on reload.
	var imgs = [{% for bg in backgrounds %}"{{ static_base }}/img/backgrounds/{{ bg }}"{% if not loop.last %},{% endif %}{% endfor %}];
	var a = document.querySelector('.hero-bg .layer-a');
	if (a && imgs.length) {
		var pick = imgs[Math.floor(Math.random() * imgs.length)];
		a.style.backgroundImage = "url('" + pick + "')";
		a.classList.add('active');
	}
})();
</script>

</body>
</html>
